{
  "plugin": "HP-GMC-Manager",
  "repo": "HolisticPeople/HP-GMC-Manager",
  "schema_version": "1.0",
  "owns": [
    "Merchant Center feeds and product identifier validation",
    "Google Customer Reviews configuration, strict survey payload, first-party consent, and single Google survey adapter"
  ],
  "must_not_own": [
    "checkout order authorization or immutable delivery promises",
    "HP-Zen confirmation composition",
    "cross-plugin source mutation without registered contract"
  ],
  "consumes": [
    "HP-Checkout hp_checkout_get_review_confirmation_context_v1 authenticated immutable new-order context",
    "HP-Checkout hp_checkout_render_review_confirmation_auth_fields_v1 native guest verification fields"
  ],
  "exposes": {
    "cpts": [],
    "rest": [
      "hp-gmc/v1/audiences/segments",
      "hp-gmc/v1/audiences/segments/run-abort",
      "hp-gmc/v1/audiences/segments/run-continue",
      "hp-gmc/v1/audiences/segments/run-progress",
      "hp-gmc/v1/audiences/segments/run-start",
      "hp-gmc/v1/audiences/segments/{id}",
      "hp-gmc/v1/audiences/segments/{id}/duplicate",
      "hp-gmc/v1/audiences/segments/{id}/export-csv",
      "hp-gmc/v1/audiences/segments/{id}/run",
      "hp-gmc/v1/audiences/segments/{id}/upload",
      "hp-gmc/v1/audiences/segments/{id}/upload-status",
      "hp-gmc/v1/funnel-feed",
      "hp-gmc/v1/funnel-feed/regenerate",
      "hp-gmc/v1/funnel-feed/status",
      "hp-gmc/v1/funnels",
      "hp-gmc/v1/funnels/{id}",
      "hp-gmc/v1/funnels/{id}/validate",
      "hp-gmc/v1/oauth-callback",
      "hp-gmc/v1/product-feed",
      "hp-gmc/v1/product-feed/regenerate",
      "hp-gmc/v1/product-feed/status",
      "hp-gmc/v1/supplemental-feed/{id}"
    ],
    "shortcodes": [],
    "providers": [
      "hp_gmc_get_customer_reviews_optin_v1",
      "hp_gmc_render_customer_reviews_optin_v1"
    ],
    "options": [
      "hp_gmc_ucp_checkout_eligibility",
      "hp_gmc_customer_reviews_enabled"
    ]
  },
  "verification": {
    "staging": {
      "status": "unverified"
    },
    "production": {
      "status": "unverified"
    }
  }
}
