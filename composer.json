{
    "name": "holisticpeople/hp-gmc-manager",
    "description": "Google Merchant Center management with admin dashboard and MCP abilities",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Holistic People",
            "email": "dev@holisticpeople.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "google/shopping-merchant-accounts": "^0.1",
        "google/shopping-merchant-products": "^0.1",
        "google/auth": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "HP_GMC\\": "includes/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}
